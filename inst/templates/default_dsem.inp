TITLE: Complete data generation;
MONTECARLO:
NAMES ARE y1 y2 y3 x1 x2 x3;
NOBSERVATIONS = 200;
NCSIZES = 1;
CSIZES = 10(20);
NREP = 2;
SEED = 1;
REPSAVE = ALL;
SAVE = rep*.dat;
ANALYSIS:
TYPE = TWOLEVEL RANDOM;
ESTIMATOR = BAYES;
PROCESSORS = 2;
FBITERATIONS = 100;
MODEL POPULATION:
%WITHIN%
Sy BY y1@0.8(&1);
Sy BY y2@0.6(&1);
Sy BY y3@0.6(&1);
Sx BY x1@0.8(&1);
Sx BY x2@0.6(&1);
Sx BY x3@0.6(&1);
phi1 | Sy ON Sy&1;
phi2 | Sx ON Sx&1;
phi3 | Sx ON Sy&1;
phi4 | Sy ON Sx&1;
NCov BY Sy@1 Sx@1;
err1 | y1;
err2 | y2;
err3 | y3;
err4 | x1;
err5 | x2;
err6 | x3;
logVSy | Sy;
logVSx | Sx;
logcov | NCov;
%BETWEEN%
[phi1@0.2];
[phi2@0.2];
[phi3@0.1];
[phi4@0.1];
[err1@-1.20397280432594];
[err2@-1.20397280432594];
[err3@-1.20397280432594];
[err4@-1.20397280432594];
[err5@-1.20397280432594];
[err6@-1.20397280432594];
[logVSy@0];
[logVSx@0];
[logcov@-2.99573227355399];
phi1@0.01;
phi2@0.01;
phi3@0.01;
phi4@0.01;
err1@0.05;
err2@0.05;
err3@0.05;
err4@0.05;
err5@0.05;
err6@0.05;
logVSy@0.05;
logVSx@0.05;
logcov@0.01;
Ty BY y1@0.7;
Ty BY y2@0.7;
Ty BY y3@0.7;
Tx BY x1@0.7;
Tx BY x2@0.7;
Tx BY x3@0.7;
[y1@0];
[y2@0];
[y3@0];
[x1@0];
[x2@0];
[x3@0];
y1@0.2;
y2@0.2;
y3@0.2;
x1@0.2;
x2@0.2;
x3@0.2;
[Ty@0];
[Tx@0];
Ty@1;
Tx@1;
Ty WITH Tx@0.2;
MODEL:
%WITHIN%
Sy BY y1*(&1);
Sy BY y2*(&1);
Sy BY y3*(&1);
Sx BY x1*(&1);
Sx BY x2*(&1);
Sx BY x3*(&1);
phi1 | Sy ON Sy&1;
phi2 | Sx ON Sx&1;
phi3 | Sx ON Sy&1;
phi4 | Sy ON Sx&1;
NCov BY Sy@1 Sx@1;
err1 | y1;
err2 | y2;
err3 | y3;
err4 | x1;
err5 | x2;
err6 | x3;
logVSy | Sy;
logVSx | Sx;
logcov | NCov;
%BETWEEN%
[phi1] ;
[phi2] ;
[phi3] ;
[phi4] ;
[err1] ;
[err2] ;
[err3] ;
[err4] ;
[err5] ;
[err6] ;
[logVSy@0];
[logVSx@0];
[logcov];
phi1;
phi2;
phi3;
phi4;
err1;
err2;
err3;
err4;
err5;
err6;
logVSy;
logVSx;
logcov;
Ty BY y1*;
Ty BY y2*;
Ty BY y3*;
Tx BY x1*;
Tx BY x2*;
Tx BY x3*;
[y1];
[y2];
[y3];
[x1];
[x2];
[x3];
y1;
y2;
y3;
x1;
x2;
x3;
[Ty@0];
[Tx@0];
Ty@1;
Tx@1;
Ty WITH Tx;
OUTPUT: TECH8;
