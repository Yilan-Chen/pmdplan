\name{pmdplan-package}
\alias{pmdplan-package}
\alias{pmdplan}
\docType{package}
\title{Construct and Evaluate Planned Missing Data Designs}
\description{Prepare PMD schedules for actual data collection, apply planned missingness to existing longitudinal data, and evaluate existing Mplus, posterior-chain or manually supplied results.}
\details{Version 0.1.0. Start with \code{\link{pmdplan_getting_started}}. The included \code{\link{affect}} data provide 76 retained measurements per participant for empirical examples; see its help for the separate CC BY-NC 4.0 data license. Use \code{\link{generate_mplus_data}} to generate complete replications through Mplus. Use \code{\link{analyze_mplus}} to analyze complete or PMD datasets in parallel. Analysis fitting remains separate from pmd_batch and evaluate_pmd.}
